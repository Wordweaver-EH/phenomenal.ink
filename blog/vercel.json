{
    "cleanUrls": true,
    "trailingSlash": false,
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "dist",
    "framework": "astro",
    "headers": [
        {
            "source": "/fonts/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}