---
const { pathname } = Astro.url;

// Logic to match the script's slug generation
// Remove trailing slash, then replace slashes with hyphens
// e.g. /docs/intro/ -> docs-intro
// e.g. / -> home
let slug = pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
if (slug === '') slug = 'home';

const pdfUrl = `/pdfs/${slug}.pdf`;
---

<a href={pdfUrl} class="print-button" target="_blank" title="View PDF Version">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-down">
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
    <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
    <path d="M12 18v-6"/>
    <path d="M9 15l3 3 3-3"/>
  </svg>
</a>

<style>
  .print-button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    opacity: 0.8;
    transition: opacity 0.2s;
    padding-top: 0.3rem;
  }

  .print-button:hover {
    opacity: 1;
    color: var(--accent-color);
  }

  /* Hide in print */
  @media print {
    .print-button {
      display: none !important;
    }
  }
</style>
