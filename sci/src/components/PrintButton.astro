---
const { pathname } = Astro.url;

// Logic to match the script's slug generation
// Remove trailing slash, then replace slashes with hyphens
// e.g. /docs/intro/ -> docs-intro
// e.g. / -> home
let slug = pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
if (slug === '') slug = 'home';

const pdfUrl = `/pdfs/${slug}.pdf`;

// Only show on actual content pages, not home or blog index
const isContentPage = slug !== 'home' && slug !== 'blog' && !slug.startsWith('blog-');
---

{isContentPage && (
  <a href={pdfUrl} class="print-button" target="_blank" title="View PDF Version">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
      <polyline points="14 2 14 8 20 8"/>
      <text x="7" y="17" font-size="6" font-weight="bold" fill="currentColor" stroke="none">PDF</text>
    </svg>
  </a>
)}

<style>
  .print-button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    opacity: 0.8;
    transition: opacity 0.2s;
    padding-top: 0.3rem;
  }

  .print-button:hover {
    opacity: 1;
    color: var(--accent-color);
  }

  /* Hide in print */
  @media print {
    .print-button {
      display: none !important;
    }
  }
</style>
