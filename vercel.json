{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "sci/dist",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  }
}